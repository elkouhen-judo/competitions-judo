{
  "scripts": {
    "build:styles": "tailwindcss -c tailwind.config.js -i assets/app.tailwind.css -o assets/app.css",
    "build:assets": "node scripts/build-assets.js",
    "build:core": "node scripts/build-core.js",
    "postinstall": "npm run build:styles && npm run build:assets && npm run build:core",
    "pretest": "npm run build:styles && npm run build:assets && npm run build:core",
    "test": "node --test tests/*.test.js",
    "test:ast": "ast-grep test",
    "test:coverage": "npm run build:styles && npm run build:assets && npm run build:core && node --test --experimental-test-coverage tests/*.test.js",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "dev:prod": "vercel dev --listen 3100",
    "dev:dev": "VERCEL_ORG_ID=team_RvEgPCDetancG3mzS4xHRnTs VERCEL_PROJECT_ID=prj_7kueNICqzzz4Oc2BbLgegSOkA1gy vercel dev --listen 3100",
    "app:deploy:prod": "npm test && npm run build:assets && vercel --prod",
    "app:deploy:dev": "npm test && npm run build:assets && VERCEL_ORG_ID=team_RvEgPCDetancG3mzS4xHRnTs VERCEL_PROJECT_ID=prj_7kueNICqzzz4Oc2BbLgegSOkA1gy vercel --prod",
    "db:pull-env:prod": "vercel env pull --environment=production .env.local",
    "db:pull-env:dev": "VERCEL_ORG_ID=team_RvEgPCDetancG3mzS4xHRnTs VERCEL_PROJECT_ID=prj_7kueNICqzzz4Oc2BbLgegSOkA1gy vercel env pull --environment=production .env.local",
    "db:deploy": "node scripts/db-deploy.js",
    "db:status": "node scripts/db-status.js",
    "db:check": "node scripts/db-check.js",
    "db:reset": "node scripts/db-reset.js",
    "redeploy:prod": "npm run db:pull-env:prod && npm run db:deploy && npm run app:deploy:prod",
    "redeploy:dev": "npm run db:pull-env:dev && npm run db:deploy && npm run app:deploy:dev",
    "sonar:up": "docker-compose -f docker-compose.sonarqube.yml up -d",
    "sonar:down": "docker-compose -f docker-compose.sonarqube.yml down",
    "sonar:scan": "docker run --rm --network=host -e SONAR_HOST_URL=http://localhost:9090 -e SONAR_TOKEN -v \"$PWD:/usr/src\" sonarsource/sonar-scanner-cli"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.85",
    "@ai-sdk/vue": "3.0.208",
    "ai": "6.0.208",
    "vue": "3.5.38"
  }
}
