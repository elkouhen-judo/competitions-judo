{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(rtk npm test)",
      "Bash(npm run typecheck)",
      "Bash(rtk npm run typecheck)",
      "Bash(npm run build:*)",
      "Bash(rtk npm run build:*)",
      "Bash(./node_modules/.bin/eslint *)",
      "Bash(git status*)",
      "Bash(rtk git status*)",
      "Bash(git diff*)",
      "Bash(rtk git diff*)",
      "Bash(git log*)",
      "Bash(rtk git log*)"
    ],
    "ask": [
      "Bash(npm run app:deploy:*)",
      "Bash(rtk npm run app:deploy:*)",
      "Bash(npm run redeploy:*)",
      "Bash(rtk npm run redeploy:*)",
      "Bash(vercel --prod*)",
      "Bash(rtk vercel --prod*)",
      "Bash(npm run db:deploy*)",
      "Bash(rtk npm run db:deploy*)",
      "Bash(npm run db:reset*)",
      "Bash(rtk npm run db:reset*)",
      "Bash(npm run db:restore*)",
      "Bash(rtk npm run db:restore*)",
      "Bash(supabase db query --remote*)",
      "Bash(rtk supabase db query --remote*)",
      "Bash(supabase db push*)",
      "Bash(rtk supabase db push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60,
            "statusMessage": "eslint sur le fichier modifié…"
          }
        ]
      }
    ]
  }
}
