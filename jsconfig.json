{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.js",
    "api/**/*.js",
    "assets/**/*.js",
    "assets/**/*.ts",
    "assets/**/*.d.ts"
  ],
  "exclude": ["node_modules", "tests", "assets/vendor", "assets/dist"]
}
